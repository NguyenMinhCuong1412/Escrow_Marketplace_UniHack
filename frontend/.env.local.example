# Chain ID (43113 cho Avalanche Fuji, 31337 cho Anvil local)
NEXT_PUBLIC_CHAIN_ID=43113

# Smart Contract Addresses (từ contracts/deployments/<chainId>.json)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Block number lúc deploy (tối ưu hóa getLogs event filter)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Backend Attest Service URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# IPFS Gateway URL
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# WalletConnect Cloud Project ID (dùng cho RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Pinata JWT (CHỈ dùng phía server, không có prefix NEXT_PUBLIC_)
PINATA_JWT=

# --- Server-only BFF & Session Security (KHÔNG có tiền tố NEXT_PUBLIC_) ---
# URL nội bộ của FastAPI Backend (BFF Next.js gọi trực tiếp thay vì trình duyệt)
BACKEND_URL=http://127.0.0.1:8000

# Secret ký session cookie `escrow_auth_session` (chuỗi ngẫu nhiên >= 32 ký tự, ĐỘC LẬP với ATTEST_API_KEY)
# Bắt buộc trên Avalanche Fuji (43113): nếu để trống, xác thực phiên fail-closed (HTTP 503).
SESSION_SECRET=

# API key dùng chung với backend `ATTEST_API_KEY` để xác thực server-to-server BFF -> FastAPI
ATTEST_API_KEY=

# Bắt buộc `true` trên Avalanche Fuji (43113) để ký X-Auth-Timestamp / X-Auth-Nonce / X-Auth-Signature
REQUIRE_PROXY_SIGNATURE=true

# Tùy chọn: danh sách origin bổ sung được phép gọi CSRF-protected BFF routes (phân tách bằng dấu phẩy)
# ALLOWED_ORIGINS=https://your-demo-domain.example
