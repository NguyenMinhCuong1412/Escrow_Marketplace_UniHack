# Chain ID (43113 cho Avalanche Fuji, 31337 cho Anvil local)
NEXT_PUBLIC_CHAIN_ID=43113

# Smart Contract Addresses (từ contracts/deployments/<chainId>.json)
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Block number lúc deploy (tối ưu hóa getLogs event filter)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Backend Attest Service URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# IPFS Gateway URL
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# WalletConnect Cloud Project ID (dùng cho RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# Pinata JWT (CHỈ dùng phía server, không có prefix NEXT_PUBLIC_)
PINATA_JWT=
