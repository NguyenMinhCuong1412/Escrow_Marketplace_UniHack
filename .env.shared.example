# Shared Client Zero-Config Configuration (NO OPS SECRETS ALLOWED)
# Copy to `.env` only if you want to set a custom Shared Ops Backend URL or port.
# Never put PINATA_JWT, AGENT_PRIVATE_KEY, ATTEST_API_KEY, or OPS_JWT_SECRET here.

# URL của Ops Marketplace Backend (Phase 4 HTTPS URL hoặc Ops test server URL).
# Để trống trước Phase 4: trang web vẫn chạy và báo hướng dẫn cấu hình (HTTP 503 SHARED_BACKEND_UNCONFIGURED cho API).
SHARED_API_URL=

# Cổng web local trên máy người dùng (mặc định 3000)
# CLIENT_PORT=3000

# Bật `true` CHỈ khi đặt Frontend phía sau reverse proxy TLS tin cậy gửi X-Forwarded-Proto/Host/For
# TRUST_PROXY_HEADERS=false
