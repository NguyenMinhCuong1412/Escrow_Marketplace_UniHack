# Optional Docker Compose overrides (do not commit `.env` with real secrets).
# By default, running `docker compose up --build -d` auto-generates cryptographically
# random `SESSION_SECRET` and `ATTEST_API_KEY` on a persistent Docker volume (`runtime_secrets`)
# and connects to the deployed Avalanche Fuji (43113) contracts.

# --- Optional: IPFS file uploads (listing images & evidence uploads via /api/pin) ---
# Obtain a JWT from https://app.pinata.cloud/ (fail-closed on Fuji 43113 if omitted).
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Optional: AI Auto-Agent on-chain attest() signer ---
# Leave blank for read-only marketplace browsing / wallet escrow UI.
# If enabled, must match Escrow.agent() on Avalanche Fuji (43113) with testnet AVAX for gas.
AGENT_PRIVATE_KEY=
AGENT_AUTO=false

# --- Optional: Avalanche Fuji RPC override ---
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# --- Optional: Override auto-generated BFF secrets (must be distinct, >= 32 chars) ---
# SESSION_SECRET=
# ATTEST_API_KEY=
