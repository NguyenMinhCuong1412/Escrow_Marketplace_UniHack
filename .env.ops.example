# Ops Server Configuration (`compose.ops.yaml`) — DO NOT COMMIT `.env` OR SHARE WITH CLIENTS
# Ví Owner/Arbiter (0xCa76...39Eb) tuyệt đối KHÔNG đặt trên server.

# --- Bắt buộc cho Ops Backend (Pinata Relay + AI Worker) ---
PINATA_JWT=
# AGENT_PRIVATE_KEY chỉ được nạp cho ops agent-worker (KHÔNG cấp cho public backend API container)
AGENT_PRIVATE_KEY=

# --- Chain & RPC ---
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
ESCROW_ADDRESS=0x19D053c84941411888f5b9e40c854365fdd4eb00

# --- Security & Isolation (Giữ nguyên strict fail-closed trên Fuji 43113) ---
ALLOW_LOCAL_HOSTS=false
ENFORCE_EVIDENCE_HASH=true
VERIFY_CHAIN_BEFORE_TTL_RELEASE=true
REQUIRE_PROXY_SIGNATURE=true

# --- Reverse Proxy & Shared Auth Origins ---
# Bật `true` khi backend đứng sau Nginx/Caddy/Cloudflare tin cậy:
TRUST_PROXY_FORWARDED_FOR=false
TRUST_PROXY_HEADERS=false
# Để trống OPS_AUTH_ALLOWED_ORIGINS để cho phép mọi Shared Client local ký EIP-191 hợp lệ,
# hoặc liệt kê rõ danh sách origin được phép (tách biệt hoàn toàn với CORS_ORIGINS):
OPS_AUTH_ALLOWED_ORIGINS=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Tùy chọn: ghi đè secrets tự sinh (tối thiểu 32 ký tự và phải khác nhau từng đôi một) ---
# OPS_JWT_SECRET=
# ATTEST_API_KEY=
# SESSION_SECRET=
