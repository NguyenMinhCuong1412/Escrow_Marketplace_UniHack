{
  "name": "Escrow Marketplace (Docker Compose)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Escrow Marketplace (Web UI)",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "Escrow Backend API (Internal/Health)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "COMPOSE_FILE": "compose.yaml:.devcontainer/compose.codespaces.yml"
  },
  "remoteEnv": {
    "COMPOSE_FILE": "compose.yaml:.devcontainer/compose.codespaces.yml"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true
      }
    }
  }
}
