# Copy thành backend/.env rồi điền. KHÔNG commit file .env (đã có trong .gitignore).

# RPC: anvil local hoặc Fuji
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key ví agent (ví riêng, chỉ dùng để gọi attest()). Phải trùng Escrow.agent().
AGENT_PRIVATE_KEY=

# Địa chỉ Escrow. Bỏ trống → tự đọc contracts/deployments/<chainId>.json
ESCROW_ADDRESS=

# Bảo mật & Xác thực API
ATTEST_API_KEY=               # API key cho POST /verify-evidence & /trade/{id}/uris. Rỗng = tắt auth (chỉ chain 31337; trên chain != 31337 bắt buộc phải có key, nếu không backend trả 503 fail-closed)
ALLOW_LOCAL_HOSTS=false       # true = cho phép download từ IP private (chỉ chain 31337; trên chain != 31337 true sẽ bị từ chối 503 fail-closed)
CORS_ORIGINS=                 # Rỗng = không cho origin nào. Ví dụ: http://localhost:3000,https://myapp.com

# AI Agent tự động (DEC-005 phương án A): backend tự quét contract và tự verify + attest()
# khi một giao dịch đã đủ bằng chứng và đủ URI (frontend tự đăng ký qua POST /trade/{id}/uris).
# Khuyến nghị tách tiến trình riêng: chạy API với AGENT_AUTO=false (không cần AGENT_PRIVATE_KEY)
# và chạy worker riêng (`python worker.py`) giữ AGENT_PRIVATE_KEY dùng chung SQLite WAL (DATA_DIR/marketplace.db).
AGENT_AUTO=false              # true = bật agent chạy nền trong tiến trình API. false = dùng worker.py riêng hoặc chỉ chạy thủ công
# AGENT_POLL_SECONDS=5
# RECONCILE_POLL_SECONDS=10   # Chu kỳ reconcile trong worker.py (mặc định 10s)
# WORKER_LEASE_TTL_SECONDS=60 # Thời hạn leader lease chống 2 worker cùng gọi attest()
# TRADE_LOCK_TTL_SECONDS=300  # Thời hạn khóa xử lý theo trade_id xuyên tiến trình

# Tuỳ chọn khác
# ESCROW_ABI_PATH=../contracts/out/Escrow.sol/Escrow.json   (mặc định; fallback backend/abi/Escrow.json)
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
#   Gateway công cộng ở trên bị giới hạn tần suất (HTTP 429) khi tải liên tiếp. Khi demo nên dùng
#   gateway riêng của tài khoản Pinata: IPFS_GATEWAY=https://<ten-gateway>.mypinata.cloud/ipfs/
# ALLOWED_HOSTS=gateway.pinata.cloud,ipfs.io               (rỗng = chỉ cho phép gateway host)
# MAX_DOWNLOAD_MB=50
# ENFORCE_EVIDENCE_HASH=true   # false chỉ cho phép trên chain 31337; trên chain != 31337 false sẽ bị từ chối 503 fail-closed
# DATA_DIR=./data
# RESERVATION_TTL_SECONDS=1800  # Thời hạn giữ chỗ (mặc định 30 phút = 1800s) trước khi tạo Escrow
# INSPECT_LISTING_IMAGES=true   # Tải & tính SHA-256 / pHash ảnh niêm yết để cảnh báo trùng lặp
# REQUIRE_PROXY_SIGNATURE=false # false chỉ dùng cho local Anvil 31337; trên Fuji 43113 bắt buộc phải là true, nếu không backend trả 503 INSECURE_CONFIG
# PROXY_SIG_TTL_SECONDS=300
# TRUST_PROXY_FORWARDED_FOR=false
# Shared Marketplace Ops (Phase 2 — chỉ cài trên Ops Server, KHÔNG phân phối xuống client)
# ENABLE_SHARED_AUTH=false
# OPS_JWT_SECRET=             # >= 32 ký tự, độc lập với ATTEST_API_KEY
# OPS_AUTH_ALLOWED_ORIGINS=   # Comma-separated origin/domain được phép xin challenge
# OPS_AUTH_CHALLENGE_TTL_SECONDS=300
# OPS_AUTH_SESSION_TTL_SECONDS=86400
# PINATA_JWT=                 # JWT Pinata chỉ giữ trên Ops Server cho POST /pin relay
# PIN_MAX_WALLET_FILES=20
# PIN_MAX_IP_FILES=40
# READ_RATE_LIMIT_PER_MIN=240
# VERIFY_TRADE_COOLDOWN_SECONDS=20
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# LOG_LEVEL=INFO
