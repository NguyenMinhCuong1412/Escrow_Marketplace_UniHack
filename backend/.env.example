# Copy thành backend/.env rồi điền. KHÔNG commit file .env (đã có trong .gitignore).

# RPC: anvil local hoặc Fuji
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key ví agent (ví riêng, chỉ dùng để gọi attest()). Phải trùng Escrow.agent().
AGENT_PRIVATE_KEY=

# Địa chỉ Escrow. Bỏ trống → tự đọc contracts/deployments/<chainId>.json
ESCROW_ADDRESS=

# Bảo mật & Xác thực API
ATTEST_API_KEY=               # API key cho POST /verify-evidence & /trade/{id}/uris. Rỗng = tắt auth (chỉ chain 31337; trên chain != 31337 bắt buộc phải có key, nếu không backend trả 503 fail-closed)
ALLOW_LOCAL_HOSTS=false       # true = cho phép download từ IP private (chỉ chain 31337; trên chain != 31337 true sẽ bị từ chối 503 fail-closed)
CORS_ORIGINS=                 # Rỗng = không cho origin nào. Ví dụ: http://localhost:3000,https://myapp.com

# AI Agent tự động (DEC-005 phương án A): backend tự quét contract và tự verify + attest()
# khi một giao dịch đã đủ bằng chứng và đủ URI (frontend tự đăng ký qua POST /trade/{id}/uris).
AGENT_AUTO=false              # true = bật agent chạy nền. false = chỉ chạy khi gọi POST /verify-evidence
# AGENT_POLL_SECONDS=5

# Tuỳ chọn khác
# ESCROW_ABI_PATH=../contracts/out/Escrow.sol/Escrow.json   (mặc định; fallback backend/abi/Escrow.json)
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
#   Gateway công cộng ở trên bị giới hạn tần suất (HTTP 429) khi tải liên tiếp. Khi demo nên dùng
#   gateway riêng của tài khoản Pinata: IPFS_GATEWAY=https://<ten-gateway>.mypinata.cloud/ipfs/
# ALLOWED_HOSTS=gateway.pinata.cloud,ipfs.io               (rỗng = chỉ cho phép gateway host)
# MAX_DOWNLOAD_MB=50
# ENFORCE_EVIDENCE_HASH=true   # false chỉ cho phép trên chain 31337; trên chain != 31337 false sẽ bị từ chối 503 fail-closed
# DATA_DIR=./data
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# LOG_LEVEL=INFO
