# Copy thành backend/.env rồi điền. KHÔNG commit file .env (đã có trong .gitignore).

# RPC: anvil local hoặc Fuji
RPC_URL=http://127.0.0.1:8545
# RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Private key ví agent (ví riêng, chỉ dùng để gọi attest()). Phải trùng Escrow.agent().
AGENT_PRIVATE_KEY=

# Địa chỉ Escrow. Bỏ trống → tự đọc contracts/deployments/<chainId>.json
ESCROW_ADDRESS=

# Bảo mật & Xác thực API
ATTEST_API_KEY=               # API key cho POST /verify-evidence. Rỗng = tắt auth (dev only)
ALLOW_LOCAL_HOSTS=false       # true = cho phép download từ IP private (dev only, KHÔNG dùng production)
CORS_ORIGINS=                 # Rỗng = không cho origin nào. Ví dụ: http://localhost:3000,https://myapp.com

# Tuỳ chọn khác
# ESCROW_ABI_PATH=../contracts/out/Escrow.sol/Escrow.json   (mặc định; fallback backend/abi/Escrow.json)
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# ALLOWED_HOSTS=gateway.pinata.cloud,ipfs.io               (rỗng = chỉ cho phép gateway host)
# MAX_DOWNLOAD_MB=50
# ENFORCE_EVIDENCE_HASH=true
# DATA_DIR=./data
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# LOG_LEVEL=INFO
